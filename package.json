{
  "name": "wok-ing-dead",
  "version": "0.1.0",
  "private": true,
  "description": "雨夜唐人街打僵尸的浏览器 FPS（Three.js）",
  "homepage": "https://wok.huang.co",
  "repository": {
    "type": "git",
    "url": "https://github.com/dashhuang/wok-ing-dead.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:single": "node scripts/single/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "arsenal": "vite --config arsenal/vite.config.js",
    "arsenal:build": "vite build --config arsenal/vite.config.js",
    "arsenal:single": "node arsenal/scripts/single.mjs",
    "arsenal:test": "playwright test -c arsenal/playwright.config.js",
    "check": "node scripts/check-syntax.mjs && node arsenal/scripts/check-data.mjs && prettier --check . && node scripts/balance/report.mjs --check",
    "balance": "node scripts/balance/report.mjs",
    "balance:check": "node scripts/balance/report.mjs --check",
    "balance:sim": "node scripts/balance/run.mjs",
    "format": "prettier --write .",
    "test": "node --test tests/navigation/*.test.mjs tests/telemetry/*.test.mjs tests/startup/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run build && npm test",
    "test:telemetry": "node --test tests/telemetry/*.test.mjs",
    "telemetry:migrate": "node scripts/telemetry/migrate.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:navigation": "node --test tests/navigation/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "prettier": "^3.9.10",
    "three": "^0.180.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "zod": "^4.6.7"
  }
}
